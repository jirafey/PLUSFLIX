<!DOCTYPE html>
<html>
<head>
    <title>Streaming Services</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-white">
<div class="container mt-5">
    <h1>Streaming Services in DB</h1>

    <div class="mb-3">
        <a href="{{ path('app_add_service') }}" class="btn btn-success">
            + Add New Service
        </a>
    </div>
    <table class="table table-striped table-dark">
        <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Website</th>
            <th>Action</th>
        </tr>
        </thead>
        <tbody>
        {% for s in services %}
            <tr>
                <td>{{ s.id }}</td>
                <td>{{ s.name }}</td>
                <td><a href="{{ s.website }}" class="text-info">{{ s.website }}</a></td>

                <td>
                    <a href="{{ path('app_delete_service', {id: s.id}) }}"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Are you sure you want to delete {{ s.name }}?')">
                        Delete
                    </a>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="4">No services yet – add Netflix with the script!</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
</body>
</html>
